<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Альфа-Гига-Чад">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="icon" type="image/png" href="favicon.png">
<title>Как стать альфа-гига-чадом</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
  html, body { height:100%; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, sans-serif;
    background: linear-gradient(180deg, #9fd0f7 0%, #bfe0fa 35%, #dceffc 100%);
    background-attachment: fixed;
    color:#123a5c;
    min-height:100vh;
  }
  /* Место под бровку телефона */
  .notch-space { height: max(env(safe-area-inset-top, 0px), 54px); }
  .app { max-width:430px; margin:0 auto; padding:0 16px calc(env(safe-area-inset-bottom, 0px) + 32px); }

  header { text-align:center; padding:10px 0 4px; }
  header h1 { font-size:22px; font-weight:800; letter-spacing:-0.3px; }
  header .sub { font-size:13px; color:#3d6a92; margin-top:2px; }

  .datebar { display:flex; align-items:center; justify-content:center; gap:14px; margin:12px 0 6px; }
  .datebar button {
    border:none; background:rgba(255,255,255,0.75); color:#1d6fb8;
    width:34px; height:34px; border-radius:50%; font-size:18px; font-weight:700;
    box-shadow:0 1px 3px rgba(30,80,130,0.15); cursor:pointer;
  }
  .datebar button:disabled { opacity:0.35; }
  .datebar .cur { font-size:15px; font-weight:700; min-width:150px; text-align:center; }
  .datebar .cur small { display:block; font-weight:500; font-size:11px; color:#3d6a92; }

  .section { margin-top:18px; }
  .section h2 {
    font-size:13px; text-transform:uppercase; letter-spacing:0.08em;
    color:#2b5d8c; margin:0 4px 8px; font-weight:700;
  }
  .card {
    background:rgba(255,255,255,0.88); border-radius:18px;
    box-shadow:0 2px 10px rgba(30,80,130,0.10); overflow:hidden;
  }
  .row {
    display:flex; align-items:center; gap:12px; padding:13px 14px;
    border-bottom:0.5px solid rgba(30,80,130,0.10); cursor:pointer; user-select:none; -webkit-user-select:none;
  }
  .row:last-child { border-bottom:none; }
  .chk {
    flex:0 0 26px; width:26px; height:26px; border-radius:50%;
    border:2px solid #8fb8d9; display:flex; align-items:center; justify-content:center;
    font-size:15px; color:#fff; transition:all .15s ease; background:transparent;
  }
  .row.done .chk { background:#2f9e4f; border-color:#2f9e4f; }
  .row .name { flex:1; font-size:15.5px; font-weight:500; line-height:1.3; }
  .row.done .name { color:#5a86ab; text-decoration:line-through; text-decoration-thickness:1px; }
  .badges { display:flex; align-items:center; gap:6px; flex:0 0 auto; }
  .streak {
    font-size:12px; font-weight:700; color:#c2410c; background:#ffedd5;
    border-radius:10px; padding:3px 7px; white-space:nowrap;
  }
  .rank { font-size:17px; }

  .reportbtn {
    margin-top:20px; width:100%; border:none; background:#1d6fb8; color:#fff;
    font-size:16px; font-weight:700; padding:15px; border-radius:16px; cursor:pointer;
    box-shadow:0 4px 14px rgba(29,111,184,0.35);
  }
  .reportbtn:active { transform:scale(0.98); }

  /* Общий стрик дня */
  .daycard { padding:14px 16px; }
  .daycard .toprow { display:flex; align-items:center; justify-content:space-between; }
  .daycard .cnt { font-size:15px; font-weight:700; }
  .daycard .cnt small { font-weight:500; color:#3d6a92; }
  .daybar { height:8px; background:#e3eef7; border-radius:4px; margin:10px 0; overflow:hidden; }
  .daybar div { height:100%; background:linear-gradient(90deg,#4aa3e8,#2f9e4f); border-radius:4px; transition:width .3s ease; }
  .thresh { display:flex; align-items:center; justify-content:space-between; font-size:13px; color:#2b5d8c; }
  .thresh .stepper { display:flex; align-items:center; gap:10px; }
  .thresh .stepper button {
    width:28px; height:28px; border-radius:50%; border:none; background:#e3eef7;
    color:#1d6fb8; font-size:16px; font-weight:800; cursor:pointer;
  }
  .thresh .stepper b { min-width:16px; text-align:center; }
  .daystreakline { margin-top:10px; font-size:13.5px; }
  .daystreakline b { color:#c2410c; }

  /* Календарь */
  .cal { padding:14px 12px 16px; }
  .calhead { display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; padding:0 4px; }
  .calhead .m { font-size:15px; font-weight:700; text-transform:capitalize; }
  .calhead button {
    border:none; background:#e3eef7; color:#1d6fb8; width:28px; height:28px;
    border-radius:50%; font-size:15px; font-weight:700; cursor:pointer;
  }
  .calhead button:disabled { opacity:0.35; }
  .calgrid { display:grid; grid-template-columns:repeat(7,1fr); gap:5px; }
  .calgrid .wd { text-align:center; font-size:10.5px; color:#3d6a92; font-weight:600; padding:2px 0; }
  .cell {
    aspect-ratio:1; border-radius:9px; display:flex; align-items:center; justify-content:center;
    font-size:12.5px; font-weight:600; color:#2b5d8c; background:#eef5fb; position:relative; cursor:pointer;
  }
  .cell.empty { background:transparent; cursor:default; }
  .cell.future { opacity:0.35; cursor:default; }
  .cell.today { outline:2px solid #1d6fb8; outline-offset:-2px; }
  .cell.ok::after {
    content:''; position:absolute; bottom:3px; left:50%; transform:translateX(-50%);
    width:5px; height:5px; border-radius:50%; background:#2f9e4f;
  }
  .cell.lv1 { background:#cfe4f6; }
  .cell.lv2 { background:#9ecdee; }
  .cell.lv3 { background:#5faade; color:#fff; }
  .cell.lv4 { background:#2b7fc4; color:#fff; }
  .cell.lv4.ok::after, .cell.lv3.ok::after { background:#b6f7c8; }

  .stats { margin-top:22px; }
  .stats .card { padding:14px 16px; }
  .stats p { font-size:14px; line-height:1.55; margin:6px 0; }
  .stats p b { color:#c2410c; }
  .stats p .rec { color:#3d6a92; font-size:12.5px; }
  .stats .empty { color:#5a86ab; font-size:13.5px; }

  .legend .card { padding:12px 16px; }
  .legend p { font-size:13px; margin:5px 0; color:#2b5d8c; }
  .legend p span.t { font-weight:700; }
  .legend p.locked { color:#7e9cb8; font-style:italic; }

  /* Модалки */
  .overlay {
    position:fixed; inset:0; background:rgba(18,58,92,0.45);
    display:none; align-items:center; justify-content:center; z-index:50; padding:24px;
    backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px);
  }
  .overlay.show { display:flex; }
  .modal {
    background:#fff; border-radius:24px; padding:28px 22px; text-align:center;
    max-width:320px; width:100%; box-shadow:0 12px 40px rgba(18,58,92,0.35);
    animation:pop .3s ease;
  }
  @keyframes pop { from { transform:scale(0.8); opacity:0; } to { transform:scale(1); opacity:1; } }
  .modal .big { font-size:56px; }
  .modal h3 { font-size:20px; margin:10px 0 4px; color:#123a5c; }
  .modal .rankname { font-size:17px; font-weight:800; color:#1d6fb8; margin-bottom:8px; }
  .modal p { font-size:14.5px; line-height:1.5; color:#2b5d8c; }
  .modal button {
    margin-top:16px; border:none; background:#1d6fb8; color:#fff; font-size:16px;
    font-weight:700; padding:12px 28px; border-radius:14px; cursor:pointer; width:100%;
  }
  .modal.sad button { background:#c2410c; }
  .modal.sad .rankname { color:#c2410c; }
  .kiss { position:fixed; font-size:28px; z-index:60; pointer-events:none; animation:fly 2.2s ease-out forwards; }
  @keyframes fly {
    0% { transform:translateY(0) scale(0.7) rotate(0deg); opacity:0; }
    15% { opacity:1; }
    100% { transform:translateY(-45vh) scale(1.4) rotate(20deg); opacity:0; }
  }

  /* Тост-напоминание */
  .toast {
    position:fixed; top:calc(max(env(safe-area-inset-top, 0px), 54px) + 6px);
    left:16px; right:16px; max-width:400px; margin:0 auto; z-index:70;
    background:#123a5c; color:#fff; border-radius:16px; padding:13px 16px;
    font-size:14px; line-height:1.4; box-shadow:0 8px 24px rgba(18,58,92,0.4);
    display:none; cursor:pointer; animation:pop .3s ease;
  }
  .toast.show { display:block; }
</style>
</head>
<body>
<div class="notch-space"></div>
<div class="app">
  <header>
    <h1>😎 Как стать альфа-гига-чадом</h1>
    <div class="sub">Закрывай пункты каждый день — получай ранги</div>
  </header>

  <div class="datebar">
    <button id="prevDay">‹</button>
    <div class="cur"><span id="dateLabel"></span><small id="dateSub"></small></div>
    <button id="nextDay">›</button>
  </div>

  <div id="sections"></div>

  <button class="reportbtn" id="reportBtn">📤 Отправить отчёт Кате</button>

  <div class="section">
    <h2>🎯 День чада</h2>
    <div class="card daycard">
      <div class="toprow">
        <div class="cnt">Закрыто сегодня: <span id="dayCount"></span> <small id="dayTotal"></small></div>
        <div id="dayStatus" style="font-size:20px;"></div>
      </div>
      <div class="daybar"><div id="dayBarFill" style="width:0%"></div></div>
      <div class="thresh">
        <span>День засчитан от:</span>
        <span class="stepper">
          <button id="thMinus">−</button>
          <b id="thVal"></b>
          <button id="thPlus">+</button>
          <span>пунктов</span>
        </span>
      </div>
      <div class="daystreakline" id="dayStreakLine"></div>
    </div>
  </div>

  <div class="section">
    <h2>🗓 Календарь чада</h2>
    <div class="card cal">
      <div class="calhead">
        <button id="calPrev">‹</button>
        <div class="m" id="calTitle"></div>
        <button id="calNext">›</button>
      </div>
      <div class="calgrid" id="calGrid"></div>
    </div>
  </div>

  <div class="section stats">
    <h2>📊 Подсчёты и рекорды</h2>
    <div class="card" id="statsCard"></div>
  </div>

  <div class="section legend">
    <h2>🏆 Ранги</h2>
    <div class="card" id="ranksCard"></div>
  </div>
</div>

<div class="overlay" id="overlay">
  <div class="modal" id="modalBox">
    <div class="big" id="mEmoji">😎</div>
    <h3 id="mTitle">Поздравляем!</h3>
    <div class="rankname" id="mRank"></div>
    <p id="mText"></p>
    <button id="mClose">Принять поцелуйчик 💋</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
(function(){
  'use strict';

  var SECTIONS = [
    { title: '✨ Внешний вид', items: [
      { id:'wake',    name:'Встал до 8:30',            phrase:'Вы вставали вовремя' },
      { id:'sleep',   name:'Лёг спать до 23:30',       phrase:'Вы ложились вовремя' },
      { id:'serum',   name:'Сыворотка для бороды',     phrase:'Вы мазали бороду сывороткой' },
      { id:'pool',    name:'Бассейн',                  phrase:'Вы ходили в бассейн' },
      { id:'cardio',  name:'Кардио',                   phrase:'Вы делали кардио' },
      { id:'group',   name:'Групповая',                phrase:'Вы ходили на групповые' },
      { id:'gym',     name:'Треня в зале',             phrase:'Вы тренировались в зале' },
      { id:'padel',   name:'Падл',                     phrase:'Вы играли в падл' },
      { id:'cal',     name:'Считал калории',           phrase:'Вы считали калории' }
    ]},
    { title: '🎓 Академия', items: [
      { id:'read',    name:'Прочитал 20 страниц',      phrase:'Вы читали по 20 страниц' },
      { id:'article', name:'Сделал что-то для статьи/диссертации', phrase:'Вы работали над статьёй/диссертацией' }
    ]},
    { title: '💼 Работа', items: [
      { id:'plans',   name:'Сделал все планы на день', phrase:'Вы закрывали все планы дня' },
      { id:'bigdeal', name:'Важное большое дело // структурно изменилась ситуация', phrase:'Вы делали важные большие дела' }
    ]}
  ];
  var ALL_ITEMS = [];
  SECTIONS.forEach(function(s){ s.items.forEach(function(i){ ALL_ITEMS.push(i); }); });
  var DAY_ID = '__day';

  var RANKS = [
    { days:3,  name:'Чад',                                emoji:'💪', label:'3 дня подряд' },
    { days:7,  name:'Гига-чад',                           emoji:'😎', label:'7 дней подряд' },
    { days:10, name:'Гига-мега-чад',                      emoji:'🔥', label:'10 дней подряд' },
    { days:14, name:'Гига-мега-альфа-чад',                emoji:'👑', label:'2 недели подряд' },
    { days:20, name:'Гига-мега-альфа-чад ультра-стар',    emoji:'⭐️', label:'20 дней подряд' }
  ];

  /* ---------- хранилище ---------- */
  var KEY = 'alfa-giga-chad-v1';
  var memoryFallback = null;
  function loadState(){
    try {
      var raw = localStorage.getItem(KEY);
      return raw ? JSON.parse(raw) : {};
    } catch(e) { return memoryFallback || {}; }
  }
  function saveState(){
    try { localStorage.setItem(KEY, JSON.stringify(state)); }
    catch(e) { memoryFallback = state; }
  }
  var state = loadState();
  if (!state.checks) state.checks = {};
  if (!state.celebrated) state.celebrated = {};
  if (!state.peak) state.peak = {};
  if (!state.threshold) state.threshold = 5;

  /* ---------- даты ---------- */
  function fmt(d){
    var m = (d.getMonth()+1), day = d.getDate();
    return d.getFullYear() + '-' + (m<10?'0':'') + m + '-' + (day<10?'0':'') + day;
  }
  function todayStr(){ return fmt(new Date()); }
  var MONTHS = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
  var MONTHS_NOM = ['январь','февраль','март','апрель','май','июнь','июль','август','сентябрь','октябрь','ноябрь','декабрь'];
  var WDAYS = ['воскресенье','понедельник','вторник','среда','четверг','пятница','суббота'];
  var viewDate = new Date();
  var calMonth = new Date(); calMonth.setDate(1);

  function daysWord(n){
    var t = n % 100;
    if (t >= 11 && t <= 14) return 'дней';
    var u = t % 10;
    if (u === 1) return 'день';
    if (u >= 2 && u <= 4) return 'дня';
    return 'дней';
  }
  function pointsWord(n){
    var t = n % 100;
    if (t >= 11 && t <= 14) return 'пунктов';
    var u = t % 10;
    if (u === 1) return 'пункт';
    if (u >= 2 && u <= 4) return 'пункта';
    return 'пунктов';
  }

  /* ---------- проверки и стрики ---------- */
  function isChecked(id, dateStr){
    return !!(state.checks[id] && state.checks[id][dateStr]);
  }
  function dayCount(dateStr){
    var n = 0;
    ALL_ITEMS.forEach(function(it){ if (isChecked(it.id, dateStr)) n++; });
    return n;
  }
  function dayOk(dateStr){ return dayCount(dateStr) >= state.threshold; }

  function streakFrom(pred){
    var d = new Date();
    if (!pred(fmt(d))) d.setDate(d.getDate()-1); // сегодня ещё не закрыт — стрик жив со вчера
    var n = 0;
    while (pred(fmt(d))) { n++; d.setDate(d.getDate()-1); }
    return n;
  }
  function currentStreak(id){
    if (id === DAY_ID) return streakFrom(dayOk);
    return streakFrom(function(ds){ return isChecked(id, ds); });
  }

  function allDates(){
    var set = {};
    Object.keys(state.checks).forEach(function(id){
      Object.keys(state.checks[id]).forEach(function(ds){ set[ds] = true; });
    });
    return Object.keys(set);
  }
  function bestStreakOf(dates){
    if (!dates.length) return 0;
    var ts = dates.map(function(ds){ return Date.parse(ds + 'T00:00:00Z'); }).sort(function(a,b){ return a-b; });
    var best = 1, cur = 1;
    for (var i=1;i<ts.length;i++){
      if (ts[i] - ts[i-1] === 86400000) { cur++; if (cur > best) best = cur; }
      else if (ts[i] !== ts[i-1]) cur = 1;
    }
    return best;
  }
  function bestStreak(id){
    if (id === DAY_ID) return bestStreakOf(allDates().filter(dayOk));
    return bestStreakOf(Object.keys(state.checks[id] || {}));
  }

  function rankFor(days){
    var r = null;
    for (var i=0;i<RANKS.length;i++) if (days >= RANKS[i].days) r = RANKS[i];
    return r;
  }

  /* ---------- рендер ---------- */
  var sectionsEl = document.getElementById('sections');
  var statsEl = document.getElementById('statsCard');
  var dateLabel = document.getElementById('dateLabel');
  var dateSub = document.getElementById('dateSub');
  var prevBtn = document.getElementById('prevDay');
  var nextBtn = document.getElementById('nextDay');

  function render(){
    var ds = fmt(viewDate);
    var isToday = ds === todayStr();
    dateLabel.textContent = isToday ? 'Сегодня' : viewDate.getDate() + ' ' + MONTHS[viewDate.getMonth()];
    dateSub.textContent = isToday
      ? viewDate.getDate() + ' ' + MONTHS[viewDate.getMonth()] + ', ' + WDAYS[viewDate.getDay()]
      : WDAYS[viewDate.getDay()];
    nextBtn.disabled = isToday;

    sectionsEl.innerHTML = '';
    SECTIONS.forEach(function(sec){
      var wrap = document.createElement('div');
      wrap.className = 'section';
      var h = document.createElement('h2');
      h.textContent = sec.title;
      wrap.appendChild(h);
      var card = document.createElement('div');
      card.className = 'card';
      sec.items.forEach(function(item){
        var row = document.createElement('div');
        var done = isChecked(item.id, ds);
        row.className = 'row' + (done ? ' done' : '');
        var streak = currentStreak(item.id);
        var rank = rankFor(streak);
        row.innerHTML =
          '<div class="chk">' + (done ? '✓' : '') + '</div>' +
          '<div class="name">' + item.name + '</div>' +
          '<div class="badges">' +
            (streak >= 2 ? '<span class="streak">🔥 ' + streak + '</span>' : '') +
            (rank ? '<span class="rank">' + rank.emoji + '</span>' : '') +
          '</div>';
        row.addEventListener('click', function(){ toggle(item, ds); });
        card.appendChild(row);
      });
      wrap.appendChild(card);
      sectionsEl.appendChild(wrap);
    });

    updatePeaks();
    renderDayCard();
    renderCalendar();
    renderStats();
    renderRanks();
  }

  /* ---------- ранги: видны только заработанные ---------- */
  function renderRanks(){
    var ids = ALL_ITEMS.map(function(i){ return i.id; }).concat([DAY_ID]);
    var maxBest = 0;
    ids.forEach(function(id){
      var b = bestStreak(id);
      if (b > maxBest) maxBest = b;
    });
    var html = '';
    var nextShown = false;
    RANKS.forEach(function(r){
      if (maxBest >= r.days) {
        html += '<p>' + r.emoji + ' <span class="t">' + r.label + '</span> — ' + r.name + '</p>';
      } else if (!nextShown) {
        nextShown = true;
        html += '<p class="locked">🔒 Следующий ранг откроется за ' + r.label + '…</p>';
      }
    });
    if (maxBest < RANKS[0].days) {
      html = '<p class="locked">🔒 Ранги засекречены. Первый откроется, когда закроешь один пункт ' + RANKS[0].label + '.</p>';
    }
    document.getElementById('ranksCard').innerHTML = html;
  }

  function renderDayCard(){
    var t = todayStr();
    var cnt = dayCount(t);
    var total = ALL_ITEMS.length;
    document.getElementById('dayCount').textContent = cnt;
    document.getElementById('dayTotal').textContent = 'из ' + total;
    document.getElementById('dayBarFill').style.width = Math.round(cnt/total*100) + '%';
    document.getElementById('dayStatus').textContent = dayOk(t) ? '✅' : '⏳';
    document.getElementById('thVal').textContent = state.threshold;
    var s = currentStreak(DAY_ID);
    var best = bestStreak(DAY_ID);
    var line = '';
    if (s >= 1) {
      line = 'Серия дней чада: <b>' + s + ' ' + daysWord(s) + ' подряд</b>';
      var rank = rankFor(s);
      if (rank) line += ' ' + rank.emoji;
    } else {
      line = 'Закрой сегодня ' + state.threshold + ' ' + pointsWord(state.threshold) + ' — начни серию дней чада!';
    }
    if (best >= 2) line += ' <span class="rec">(рекорд: ' + best + ' ' + daysWord(best) + ')</span>';
    document.getElementById('dayStreakLine').innerHTML = line;
  }

  /* ---------- календарь ---------- */
  function renderCalendar(){
    var y = calMonth.getFullYear(), m = calMonth.getMonth();
    document.getElementById('calTitle').textContent = MONTHS_NOM[m] + ' ' + y;
    var now = new Date();
    document.getElementById('calNext').disabled = (y === now.getFullYear() && m === now.getMonth()) || calMonth > now;

    var grid = document.getElementById('calGrid');
    grid.innerHTML = '';
    ['Пн','Вт','Ср','Чт','Пт','Сб','Вс'].forEach(function(w){
      var el = document.createElement('div');
      el.className = 'wd'; el.textContent = w;
      grid.appendChild(el);
    });
    var first = new Date(y, m, 1);
    var offset = (first.getDay() + 6) % 7;
    for (var i=0;i<offset;i++){
      var e = document.createElement('div');
      e.className = 'cell empty';
      grid.appendChild(e);
    }
    var dim = new Date(y, m+1, 0).getDate();
    var total = ALL_ITEMS.length;
    var tStr = todayStr();
    for (var day=1; day<=dim; day++){
      (function(day){
        var d = new Date(y, m, day);
        var ds = fmt(d);
        var cell = document.createElement('div');
        var cls = 'cell';
        var future = ds > tStr;
        if (future) cls += ' future';
        else {
          var cnt = dayCount(ds);
          if (cnt > 0) {
            var ratio = cnt / total;
            cls += ratio >= 0.75 ? ' lv4' : ratio >= 0.5 ? ' lv3' : ratio >= 0.25 ? ' lv2' : ' lv1';
          }
          if (dayOk(ds)) cls += ' ok';
        }
        if (ds === tStr) cls += ' today';
        cell.className = cls;
        cell.textContent = day;
        if (!future) cell.addEventListener('click', function(){
          viewDate = d;
          render();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        grid.appendChild(cell);
      })(day);
    }
  }

  /* ---------- подсчёты и рекорды ---------- */
  function renderStats(){
    var html = '';
    ALL_ITEMS.forEach(function(item){
      var s = currentStreak(item.id);
      var best = bestStreak(item.id);
      if (s >= 2) {
        html += '<p>' + item.phrase + ' уже <b>' + s + ' ' + daysWord(s) + ' подряд</b>';
        var rank = rankFor(s);
        if (rank) html += ' — вы ' + rank.name + '! ' + rank.emoji;
        if (best > s) html += ' <span class="rec">(рекорд: ' + best + ' ' + daysWord(best) + ' — есть что побивать)</span>';
        html += '</p>';
      } else if (best >= 3) {
        html += '<p>«' + item.name + '» — рекорд: <b>' + best + ' ' + daysWord(best) + '</b><span class="rec">, сейчас: ' + s + '. Пора вернуть форму 💪</span></p>';
      }
    });
    if (!html) html = '<p class="empty">Пока нет серий из 2+ дней. Закрывай пункты каждый день — и здесь появятся твои рекорды 💪</p>';
    statsEl.innerHTML = html;
  }

  /* ---------- действия ---------- */
  function toggle(item, ds){
    if (!state.checks[item.id]) state.checks[item.id] = {};
    if (state.checks[item.id][ds]) {
      delete state.checks[item.id][ds];
    } else {
      state.checks[item.id][ds] = true;
      maybeCelebrate(item, item.id);
      maybeCelebrate({ name:'День чада (' + state.threshold + '+ ' + pointsWord(state.threshold) + ')' }, DAY_ID);
    }
    saveState();
    render();
  }

  function maybeCelebrate(item, id){
    var streak = currentStreak(id);
    var rank = null;
    for (var i=0;i<RANKS.length;i++) if (RANKS[i].days === streak) rank = RANKS[i];
    if (!rank) return;
    var key = todayStr() + ':' + rank.days;
    if (state.celebrated[id] === key) return;
    state.celebrated[id] = key;
    showModal(item, rank, streak);
  }

  /* пики серий — для штрафного юмора */
  function updatePeaks(){
    var changed = false;
    var lost = [];
    var ids = ALL_ITEMS.map(function(i){ return i.id; }).concat([DAY_ID]);
    ids.forEach(function(id){
      var s = currentStreak(id);
      var r = rankFor(s);
      if (r) {
        if ((state.peak[id] || 0) < r.days) { state.peak[id] = r.days; changed = true; }
      } else if (state.peak[id]) {
        // серия с рангом оборвалась
        var oldRank = null;
        for (var i=0;i<RANKS.length;i++) if (RANKS[i].days === state.peak[id]) oldRank = RANKS[i];
        var item = null;
        ALL_ITEMS.forEach(function(it){ if (it.id === id) item = it; });
        lost.push({ name: item ? item.name : 'День чада', rank: oldRank });
        delete state.peak[id];
        changed = true;
      }
    });
    if (changed) saveState();
    if (lost.length && !penaltyShown) { penaltyShown = true; showPenalty(lost); }
  }
  var penaltyShown = false;

  /* ---------- модалки ---------- */
  var overlay = document.getElementById('overlay');
  var modalBox = document.getElementById('modalBox');
  var modalQueue = [];

  function showModal(item, rank, streak){
    modalQueue.push(function(){
      modalBox.classList.remove('sad');
      document.getElementById('mEmoji').textContent = rank.emoji;
      document.getElementById('mTitle').textContent = 'Поздравляем!';
      document.getElementById('mRank').textContent = rank.name.toUpperCase();
      document.getElementById('mText').textContent =
        '«' + item.name + '» — ' + streak + ' ' + daysWord(streak) + ' подряд! ' +
        'Ваша девушка считает, что вы ' + rank.name.toLowerCase() + '. Вам поцелуйчик!';
      document.getElementById('mClose').textContent = 'Принять поцелуйчик 💋';
      overlay.classList.add('show');
      for (var i=0;i<10;i++) spawnKiss(i);
    });
    pumpModal();
  }

  function showPenalty(lost){
    modalQueue.push(function(){
      modalBox.classList.add('sad');
      document.getElementById('mEmoji').textContent = '😔';
      document.getElementById('mTitle').textContent = 'Серия оборвалась…';
      var top = lost[0];
      document.getElementById('mRank').textContent = 'Вы больше не ' + (top.rank ? top.rank.name : 'чад');
      var txt = lost.map(function(l){
        return '«' + l.name + '»' + (l.rank ? ' (был ранг ' + l.rank.name + ' ' + l.rank.emoji + ')' : '');
      }).join(', ');
      document.getElementById('mText').textContent =
        'Оборвалось: ' + txt + '. Катя расстроена 😔 Но искупить можно: закрой сегодня внеплановый пункт и начни новую серию!';
      document.getElementById('mClose').textContent = 'Искуплю! Новая серия 💪';
      overlay.classList.add('show');
    });
    pumpModal();
  }

  var modalOpen = false;
  function pumpModal(){
    if (modalOpen || !modalQueue.length) return;
    modalOpen = true;
    modalQueue.shift()();
  }
  document.getElementById('mClose').addEventListener('click', function(){
    overlay.classList.remove('show');
    modalOpen = false;
    setTimeout(pumpModal, 250);
  });

  function spawnKiss(i){
    setTimeout(function(){
      var k = document.createElement('div');
      k.className = 'kiss';
      k.textContent = Math.random() < 0.5 ? '💋' : '😘';
      k.style.left = (10 + Math.random()*80) + '%';
      k.style.bottom = (5 + Math.random()*25) + '%';
      document.body.appendChild(k);
      setTimeout(function(){ k.remove(); }, 2300);
    }, i * 130);
  }

  /* ---------- отчёт Кате ---------- */
  document.getElementById('reportBtn').addEventListener('click', function(){
    var t = todayStr();
    var closed = ALL_ITEMS.filter(function(it){ return isChecked(it.id, t); });
    var lines = [];
    lines.push('😎 Отчёт альфа-гига-чада за сегодня');
    lines.push('Закрыто: ' + closed.length + '/' + ALL_ITEMS.length + ' ' + pointsWord(ALL_ITEMS.length));
    closed.forEach(function(it){ lines.push('✅ ' + it.name); });
    var bestItem = null, bestS = 0;
    ALL_ITEMS.forEach(function(it){
      var s = currentStreak(it.id);
      if (s > bestS) { bestS = s; bestItem = it; }
    });
    if (bestItem && bestS >= 2) lines.push('🔥 Лучшая серия: «' + bestItem.name + '» — ' + bestS + ' ' + daysWord(bestS) + ' подряд');
    var ds = currentStreak(DAY_ID);
    if (ds >= 2) lines.push('🎯 Дней чада подряд: ' + ds);
    var rank = rankFor(bestS);
    if (rank) lines.push('🏆 Текущий ранг: ' + rank.name + ' ' + rank.emoji);
    var text = lines.join('\n');

    if (navigator.share) {
      navigator.share({ text: text }).catch(function(){});
    } else if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function(){
        showToast('Отчёт скопирован — вставь его Кате в чат 📋');
      }, function(){ showToast(text); });
    } else {
      showToast(text);
    }
  });

  /* ---------- тост ---------- */
  var toastEl = document.getElementById('toast');
  var toastTimer = null;
  function showToast(text){
    toastEl.textContent = text;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){ toastEl.classList.remove('show'); }, 6000);
  }
  toastEl.addEventListener('click', function(){ toastEl.classList.remove('show'); });

  /* ---------- порог дня ---------- */
  document.getElementById('thMinus').addEventListener('click', function(){
    if (state.threshold > 1) { state.threshold--; saveState(); render(); }
  });
  document.getElementById('thPlus').addEventListener('click', function(){
    if (state.threshold < ALL_ITEMS.length) { state.threshold++; saveState(); render(); }
  });

  /* ---------- навигация ---------- */
  prevBtn.addEventListener('click', function(){
    viewDate.setDate(viewDate.getDate()-1);
    render();
  });
  nextBtn.addEventListener('click', function(){
    if (fmt(viewDate) === todayStr()) return;
    viewDate.setDate(viewDate.getDate()+1);
    render();
  });
  document.getElementById('calPrev').addEventListener('click', function(){
    calMonth.setMonth(calMonth.getMonth()-1);
    renderCalendar();
  });
  document.getElementById('calNext').addEventListener('click', function(){
    calMonth.setMonth(calMonth.getMonth()+1);
    renderCalendar();
  });

  render();
})();
</script>
</body>
</html>
